// Configuration Fastfetch inspirée de NieR:Automata
// Load with --load-config nier_config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/diazixx/.mydotfiles/com.ml4w.dotfiles/.config/fastfetch/nier_logo.txt",
        "type": "file",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "custom",
            "format": " _   _ _      _____                    _                        _        "
        },
        {
            "type": "custom",
            "format": "| \\ | (_)    |  __ \\ _      /\\        | |                      | |       "
        },
        {
            "type": "custom",
            "format": "|  \\| |_  ___| |__) (_)    /  \\  _   _| |_ ___  _ __ ___   __ _| |_ __ _ "
        },
        {
            "type": "custom",
            "format": "| . ` | |/ _ \\  _  /      / /\\ \\| | | | __/ _ \\| '_ ` _ \\ / _` | __/ _` |"
        },
        {
            "type": "custom",
            "format": "| |\\  | |  __/ | \\ \\ _   / ____ \\ |_| | || (_) | | | | | | (_| | || (_| |"
        },
        {
            "type": "custom",
            "format": "|_| \\_|_|\\___|_|  \\_(_) /_/    \\_\\__,_|\\__\\___/|_| |_| |_|\\__,_|\\__\\__,_|"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#35} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "type": "packages",
            "key": "│ {#36}󰏖 pkgs    {#keys}│"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "type": "host",
            "key": "│ {#32}󰌢 host    {#keys}│"
        },
        {
            "type": "cpu",
            "key": "│ {#33}󰻠 cpu     {#keys}│",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "│ {#34}󰍛 gpu     {#keys}│"
        },
        {
            "type": "disk",
            "key": "│ {#35}󰋊 root    {#keys}│",
            "folders": "/"
        },
        {
            "type": "disk",
            "key": "│ {#35}󰋊 home    {#keys}│",
            "folders": "/home"
        },
        {
            "type": "memory",
            "key": "│ {#35}󰑭 memory  {#keys}│"
        },
        {
            "type": "swap",
            "key": "│ {#35}󰓡 swap    {#keys}│"
        },
        {
            "type": "sound",
            "key": "│ {#32} sound   {#keys}│"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "type": "shell",
            "key": "│ {#32} shell   {#keys}│"
        },
        {
            "type": "terminal",
            "key": "│ {#33} term    {#keys}│"
        },
        {
            "type": "terminalfont",
            "key": "│ {#34} font    {#keys}│"
        },
        {
            "type": "de",
            "key": "│ {#35}󰇄 desktop {#keys}│"
        },
        {
            "type": "wm",
            "key": "│ {#36} wm      {#keys}│"
        },
        {
            "type": "theme",
            "key": "│ {#37}󰉼 theme   {#keys}│"
        },
        {
            "type": "icons",
            "key": "│ {#38}󰀻 icons   {#keys}│"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}